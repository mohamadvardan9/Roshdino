<!DOCTYPE html>
<html lang="fa" dir="rtl">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - AdminPanel</title>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Vazirmatn -->
    <link rel="preconnect"
          href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700;800&display=swap"
          rel="stylesheet">

    <!-- Main CSS -->
    <link rel="stylesheet"
          href="~/css/main/index.css"
          asp-append-version="true" />


    <!-- Page Specific Styles -->
    @await RenderSectionAsync("Styles", required: false)

</head>

<body>

    <div class="admin-wrapper">

        <!-- =========================
             SIDEBAR
        ========================== -->

        <aside class="sidebar">

            <!-- =========================
                 LOGO
            ========================== -->

            <div class="sidebar-logo">

                <div class="logo-icon">
                    <i class="bi bi-grid-1x2-fill"></i>
                </div>

                <div>

                    <h5>AdminPanel</h5>

                    <span>
                        مدیریت سیستم رشدینو
                    </span>

                </div>

            </div>


            <!-- =========================
                 MENU
            ========================== -->

            <div class="sidebar-menu">

                <p class="menu-title">
                    منوی اصلی
                </p>


                <a asp-controller="Main"
                   asp-action="Index"
                   class="menu-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Main" ? "active" : "")">

                    <i class="bi bi-grid"></i>

                    <span>داشبورد</span>

                </a>


                <a asp-controller="Articles"
                   asp-action="Index"
                   class="menu-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Articles" ? "active" : "")">

                    <i class="bi bi-file-earmark-text"></i>

                    <span>
                        مقالات
                    </span>

                </a>


                <a asp-controller="ArticleCategories"
                   asp-action="Index"
                   class="menu-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "ArticleCategories" ? "active" : "")">

                    <i class="bi bi-folder"></i>

                    <span>
                        دسته‌بندی مقالات
                    </span>

                </a>


                <a asp-controller="Product"
                   asp-action="Index"
                   class="menu-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Product" ? "active" : "")">

                    <i class="bi bi-box-seam"></i>

                    <span>
                        محصولات
                    </span>

                </a>


                <a asp-controller="ProductCategories"
                   asp-action="Index"
                   class="menu-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "ProductCategories" ? "active" : "")">

                    <i class="bi bi-tags"></i>

                    <span>
                        دسته‌بندی محصولات
                    </span>

                </a>



                <p class="menu-title mt-4">
                    سیستم
                </p>


                <a asp-controller="ContactMessages"
                   asp-action="Index"
                   class="menu-item">

                    <i class="bi bi-bar-chart"></i>

                    <span>
                        پیام ها
                    </span>

                </a>




                
                <!-- =========================
                     OPTION
                ========================== -->

                <div class="theme-settings">

                    <button type="button" class="menu-item theme-toggle">

                        <i class="bi bi-gear"></i>

                        <span>
                            تنظیمات
                        </span>

                        <i class="bi bi-chevron-left theme-arrow"></i>

                    </button>


                    <div class="theme-panel">

                        <div class="theme-panel-title">
                            <strong>رنگ سایدبار</strong>
                            <span>تم مورد علاقه خود را انتخاب کنید</span>
                        </div>


                        <div class="theme-colors">

                            <button class="theme-color dark"
                                    data-theme="dark"
                                    title="مشکی">
                            </button>

                            <button class="theme-color purple"
                                    data-theme="purple"
                                    title="بنفش">
                            </button>

                            <button class="theme-color blue"
                                    data-theme="blue"
                                    title="آبی">
                            </button>

                            <button class="theme-color green"
                                    data-theme="green"
                                    title="سبز">
                            </button>

                            <button class="theme-color red"
                                    data-theme="red"
                                    title="قرمز">
                            </button>

                            <button class="theme-color slate"
                                    data-theme="slate"
                                    title="خاکستری">
                            </button>

                        </div>

                    </div>

                </div>

            </div>


            <!-- =========================
                 BOTTOM
            ========================== -->


            <!-- =========================
                 SUPPORT
            ========================== -->

            <div class="sidebar-bottom">

                <div class="support-box">

                    <div class="support-icon">
                        <i class="bi bi-headset"></i>
                    </div>

                    <div>

                        <strong>
                            نیاز به کمک دارید؟
                        </strong>

                        <small>
                            با پشتیبانی تماس بگیرید
                            <br/>
                            <b>09022702545</b>
                        </small>

                    </div>

                </div>

            </div>


            <!-- =========================
                 CREATOR NAME TAGHI
            ========================== -->
            <div class="support-boxes">

                <div class="support-icon">
                    <i class="bi bi-code-slash"></i>
                </div>

                <div class="support-content">

                    <span class="support-label">
                        طراحی و توسعه
                    </span>

                    <strong class="support-name">
                        تقی وردان
                    </strong>

                </div>

                <div class="support-status">
                    <span></span>
                </div>
            </div>

                <!-- =========================
                     LOGOUT
                ========================== -->

                <div class="sidebar-divider"></div>

                <form asp-controller="Account" asp-action="Logout" method="post" class="logout-form">
                    @Html.AntiForgeryToken()

                    <button type="submit" class="logout-item">

                        <div class="logout-left">
                            <i class="bi bi-box-arrow-right"></i>
                            <span>خروج از حساب</span>
                        </div>

                        <i class="bi bi-chevron-left"></i>

                    </button>
                </form>

        </aside>


        <!-- =========================
             MAIN
        ========================== -->

        <main class="main-content">


            <!-- =========================
                 TOPBAR
            ========================== -->

            <header class="topbar">

                <div class="mobile-logo">

                    <strong>
                        AdminPanel
                    </strong>

                </div>


                <div class="topbar-right">

                    <button class="icon-btn">

                        <i class="bi bi-search"></i>

                    </button>


                    <button class="icon-btn notification-btn">

                        <i class="bi bi-bell"></i>

                        <span></span>

                    </button>


                    <div class="admin-profile">

                        <div class="profile-avatar">
                            <img src="~/T/Tprofile.jpg" />
                        </div>

                        <div class="profile-info">

                            <strong>
                                تقی وردان
                            </strong>

                            <small>
                                مدیر ارشد سیستم
                            </small>

                        </div>

                    </div>

                </div>

            </header>


            <!-- =========================
                 PAGE CONTENT
            ========================== -->

            <div class="dashboard-content">

                @RenderBody()

            </div>

        </main>

    </div>


    <!-- Scripts -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>

        const themeSettings = document.querySelector(".theme-settings");
        const themeToggle = document.querySelector(".theme-toggle");
        const themeColors = document.querySelectorAll(".theme-color");

        const themes = {

        dark: {
        bg: "#111827",
        primary: "#7c3aed",
        secondary: "#6366f1"
        },

        purple: {
        bg: "#2e1065",
        primary: "#8b5cf6",
        secondary: "#7c3aed"
        },

        blue: {
        bg: "#0f172a",
        primary: "#2563eb",
        secondary: "#3b82f6"
        },

        green: {
        bg: "#064e3b",
        primary: "#059669",
        secondary: "#10b981"
        },

        red: {
        bg: "#450a0a",
        primary: "#dc2626",
        secondary: "#ef4444"
        },

        slate: {
        bg: "#1e293b",
        primary: "#475569",
        secondary: "#64748b"
        }

        };


        /* Open / Close */

        themeToggle.addEventListener("click", function () {

        themeSettings.classList.toggle("open");

        });


        /* Change Theme */

        themeColors.forEach(color => {

        color.addEventListener("click", function () {

        const themeName = this.dataset.theme;

        const theme = themes[themeName];

        document.documentElement.style.setProperty(
        "--sidebar-bg",
        theme.bg
        );

        document.documentElement.style.setProperty(
        "--sidebar-primary",
        theme.primary
        );

        document.documentElement.style.setProperty(
        "--sidebar-secondary",
        theme.secondary
        );


        /* Save */

        localStorage.setItem(
        "sidebarTheme",
        themeName
        );


        /* Active */

        themeColors.forEach(item => {

        item.classList.remove("active");

        });

        this.classList.add("active");

        });

        });


        /* Load Saved Theme */

        const savedTheme =
        localStorage.getItem("sidebarTheme");


        if (savedTheme && themes[savedTheme]) {

        const theme = themes[savedTheme];

        document.documentElement.style.setProperty(
        "--sidebar-bg",
        theme.bg
        );

        document.documentElement.style.setProperty(
        "--sidebar-primary",
        theme.primary
        );

        document.documentElement.style.setProperty(
        "--sidebar-secondary",
        theme.secondary
        );


        const activeColor =
        document.querySelector(
        `[data-theme="${savedTheme}"]`
        );

        if (activeColor) {

        activeColor.classList.add("active");

        }

        }

    </script>

</body>

</html>