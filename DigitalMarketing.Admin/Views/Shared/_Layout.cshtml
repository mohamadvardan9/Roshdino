<!DOCTYPE html>
<html lang="fa" dir="rtl">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - AdminPanel</title>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Vazirmatn -->
    <link rel="preconnect"
          href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700;800&display=swap"
          rel="stylesheet">

    <!-- Main CSS -->
    <link rel="stylesheet"
          href="~/css/main/index.css"
          asp-append-version="true" />


    <!-- Page Specific Styles -->
    @await RenderSectionAsync("Styles", required: false)

</head>

<body>

    <div class="admin-wrapper">

        <!-- =========================
             SIDEBAR
        ========================== -->

        <aside class="sidebar">

            <!-- Logo -->

            <div class="sidebar-logo">

                <div class="logo-icon">
                    <i class="bi bi-grid-1x2-fill"></i>
                </div>

                <div>

                    <h5>AdminPanel</h5>

                    <span>
                        مدیریت سیستم رشدینو
                    </span>

                </div>

            </div>


            <!-- Menu -->

            <div class="sidebar-menu">

                <p class="menu-title">
                    منوی اصلی
                </p>


                <a asp-controller="Main"
                   asp-action="Index"
                   class="menu-item active">

                    <i class="bi bi-house-door"></i>

                    <span>
                        داشبورد
                    </span>

                </a>


                <a asp-controller="Articles"
                   asp-action="Index"
                   class="menu-item">

                    <i class="bi bi-file-earmark-text"></i>

                    <span>
                        مقالات
                    </span>

                </a>


                <a asp-controller="ArticleCategories"
                   asp-action="Index"
                   class="menu-item">

                    <i class="bi bi-folder"></i>

                    <span>
                        دسته‌بندی مقالات
                    </span>

                </a>


                <a asp-controller="Product"
                   asp-action="Index"
                   class="menu-item">

                    <i class="bi bi-box-seam"></i>

                    <span>
                        محصولات
                    </span>

                </a>


                <a asp-controller="ProductCategories"
                   asp-action="Index"
                   class="menu-item">

                    <i class="bi bi-tags"></i>

                    <span>
                        دسته‌بندی محصولات
                    </span>

                </a>



                <p class="menu-title mt-4">
                    سیستم
                </p>


                <a href="#"
                   class="menu-item">

                    <i class="bi bi-bar-chart"></i>

                    <span>
                        گزارش‌ها
                    </span>

                </a>


                <a href="#"
                   class="menu-item">

                    <i class="bi bi-gear"></i>

                    <span>
                        تنظیمات
                    </span>

                </a>

            </div>


            <!-- Bottom -->

            <div class="sidebar-bottom">

                <div class="support-box">

                    <div class="support-icon">
                        <i class="bi bi-headset"></i>
                    </div>

                    <div>

                        <strong>
                            نیاز به کمک دارید؟
                        </strong>

                        <small>
                            با پشتیبانی تماس بگیرید
                            <br/>
                            <b>09022702545</b>
                        </small>

                    </div>

                </div>

            </div>

            <div class="support-boxes">

                <div class="support-icon">
                    <i class="bi bi-code-slash"></i>
                </div>

                <div class="support-content">

                    <span class="support-label">
                        طراحی و توسعه
                    </span>

                    <strong class="support-name">
                        تقی وردان
                    </strong>

                </div>

                <div class="support-status">
                    <span></span>
                </div>

            </div>

        </aside>


        <!-- =========================
             MAIN
        ========================== -->

        <main class="main-content">


            <!-- TOPBAR -->

            <header class="topbar">

                <div class="mobile-logo">

                    <strong>
                        AdminPanel
                    </strong>

                </div>


                <div class="topbar-right">

                    <button class="icon-btn">

                        <i class="bi bi-search"></i>

                    </button>


                    <button class="icon-btn notification-btn">

                        <i class="bi bi-bell"></i>

                        <span></span>

                    </button>


                    <div class="admin-profile">

                        <div class="profile-avatar">
                            ت
                        </div>

                        <div class="profile-info">

                            <strong>
                                تقی وردان
                            </strong>

                            <small>
                                مدیر ارشد سیستم
                            </small>

                        </div>

                    </div>

                </div>

            </header>


            <!-- =========================
                 PAGE CONTENT
            ========================== -->

            <div class="dashboard-content">

                @RenderBody()

            </div>

        </main>

    </div>


    <!-- Scripts -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>