


@{
    ViewData["Title"] = "داشبورد";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet">

<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

<link rel="stylesheet" href="~/css/main/index.css" asp-append-version="true" />

@{
    ViewData["Title"] = "داشبورد";
}


<!-- =========================
     WELCOME
========================== -->

<div class="welcome-section">

    <div>

        <span class="welcome-label">
            خوش آمدید 👋
        </span>

        <h1>
            داشبورد مدیریت
        </h1>

        <p>
            وضعیت کلی سیستم را از اینجا مدیریت و بررسی کنید.
        </p>

    </div>


    <button class="primary-btn">

        <i class="bi bi-plus-lg"></i>

        ایجاد مقاله جدید

    </button>

</div>



<!-- =========================
     STATISTICS
========================== -->

<div class="row g-4 mb-4">


    <!-- Articles -->

    <div class="col-xl-3 col-md-6">

        <div class="stat-card">

            <div class="stat-top">

                <div class="stat-icon purple">

                    <i class="bi bi-file-earmark-text"></i>

                </div>

                <span class="growth positive">
                    +12.5%
                </span>

            </div>


            <div class="stat-info">

                <span>
                    تعداد مقالات
                </span>

                <h2>
                    248
                </h2>

            </div>


            <div class="stat-footer">

                <span>
                    نسبت به ماه گذشته
                </span>

            </div>

        </div>

    </div>



    <!-- Products -->

    <div class="col-xl-3 col-md-6">

        <div class="stat-card">

            <div class="stat-top">

                <div class="stat-icon blue">

                    <i class="bi bi-box-seam"></i>

                </div>

                <span class="growth positive">
                    +8.2%
                </span>

            </div>


            <div class="stat-info">

                <span>
                    محصولات
                </span>

                <h2>
                    126
                </h2>

            </div>


            <div class="stat-footer">

                <span>
                    نسبت به ماه گذشته
                </span>

            </div>

        </div>

    </div>



    <!-- Users -->

    <div class="col-xl-3 col-md-6">

        <div class="stat-card">

            <div class="stat-top">

                <div class="stat-icon green">

                    <i class="bi bi-people"></i>

                </div>

                <span class="growth positive">
                    +18.4%
                </span>

            </div>


            <div class="stat-info">

                <span>
                    کاربران
                </span>

                <h2>
                    3,842
                </h2>

            </div>


            <div class="stat-footer">

                <span>
                    نسبت به ماه گذشته
                </span>

            </div>

        </div>

    </div>



    <!-- Views -->

    <div class="col-xl-3 col-md-6">

        <div class="stat-card">

            <div class="stat-top">

                <div class="stat-icon orange">

                    <i class="bi bi-eye"></i>

                </div>

                <span class="growth positive">
                    +24.7%
                </span>

            </div>


            <div class="stat-info">

                <span>
                    بازدید این ماه
                </span>

                <h2>
                    18.6K
                </h2>

            </div>


            <div class="stat-footer">

                <span>
                    نسبت به ماه گذشته
                </span>

            </div>

        </div>

    </div>

</div>



<!-- =========================
     CONTENT
========================== -->

<div class="row g-4">


    <!-- Articles -->

    <div class="col-xl-8">

        <div class="dashboard-card">

            <div class="card-header-custom">

                <div>

                    <h5>
                        آخرین مقالات
                    </h5>

                    <span>
                        مقالات اخیراً ایجاد یا ویرایش شده
                    </span>

                </div>

                <a asp-controller="Articles"
                   asp-action="Index">

                    مشاهده همه

                    <i class="bi bi-arrow-left"></i>

                </a>

            </div>


            <div class="table-responsive">

                <table class="table custom-table align-middle">

                    <thead>

                        <tr>

                            <th>
                                عنوان مقاله
                            </th>

                            <th>
                                دسته‌بندی
                            </th>

                            <th>
                                وضعیت
                            </th>

                            <th>
                                تاریخ
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        <tr>

                            <td>

                                <div class="article-title">

                                    <div class="article-icon">

                                        <i class="bi bi-file-text"></i>

                                    </div>

                                    <div>

                                        <strong>
                                            اصول طراحی سایت مدرن
                                        </strong>

                                        <small>
                                            مقاله آموزشی
                                        </small>

                                    </div>

                                </div>

                            </td>


                            <td>

                                <span class="category">
                                    طراحی سایت
                                </span>

                            </td>


                            <td>

                                <span class="status published">
                                    منتشر شده
                                </span>

                            </td>


                            <td>

                                <span class="date">
                                    ۱۴۰۳/۰۵/۱۸
                                </span>

                            </td>

                        </tr>


                        <tr>

                            <td>

                                <div class="article-title">

                                    <div class="article-icon">

                                        <i class="bi bi-file-text"></i>

                                    </div>

                                    <div>

                                        <strong>
                                            چگونه سئو سایت را بهبود دهیم؟
                                        </strong>

                                        <small>
                                            مقاله آموزشی
                                        </small>

                                    </div>

                                </div>

                            </td>


                            <td>

                                <span class="category">
                                    سئو
                                </span>

                            </td>


                            <td>

                                <span class="status draft">
                                    پیش‌نویس
                                </span>

                            </td>


                            <td>

                                <span class="date">
                                    ۱۴۰۳/۰۵/۱۷
                                </span>

                            </td>

                        </tr>


                        <tr>

                            <td>

                                <div class="article-title">

                                    <div class="article-icon">

                                        <i class="bi bi-file-text"></i>

                                    </div>

                                    <div>

                                        <strong>
                                            تأثیر هوش مصنوعی در بازاریابی
                                        </strong>

                                        <small>
                                            مقاله تخصصی
                                        </small>

                                    </div>

                                </div>

                            </td>


                            <td>

                                <span class="category">
                                    دیجیتال مارکتینگ
                                </span>

                            </td>


                            <td>

                                <span class="status published">
                                    منتشر شده
                                </span>

                            </td>


                            <td>

                                <span class="date">
                                    ۱۴۰۳/۰۵/۱۵
                                </span>

                            </td>

                        </tr>

                    </tbody>

                </table>

            </div>

        </div>

    </div>



    <!-- Activity -->

    <div class="col-xl-4">

        <div class="dashboard-card activity-card">

            <div class="card-header-custom">

                <div>

                    <h5>
                        فعالیت‌های اخیر
                    </h5>

                    <span>
                        آخرین فعالیت‌های سیستم
                    </span>

                </div>

            </div>


            <div class="activity-list">


                <div class="activity-item">

                    <div class="activity-icon purple">

                        <i class="bi bi-file-earmark-plus"></i>

                    </div>

                    <div class="activity-content">

                        <strong>
                            مقاله جدید ایجاد شد
                        </strong>

                        <span>
                            اصول طراحی سایت مدرن
                        </span>

                        <small>
                            ۱۰ دقیقه پیش
                        </small>

                    </div>

                </div>


                <div class="activity-item">

                    <div class="activity-icon blue">

                        <i class="bi bi-pencil"></i>

                    </div>

                    <div class="activity-content">

                        <strong>
                            مقاله ویرایش شد
                        </strong>

                        <span>
                            استراتژی بازاریابی
                        </span>

                        <small>
                            ۱ ساعت پیش
                        </small>

                    </div>

                </div>


                <div class="activity-item">

                    <div class="activity-icon orange">

                        <i class="bi bi-box-seam"></i>

                    </div>

                    <div class="activity-content">

                        <strong>
                            محصول جدید اضافه شد
                        </strong>

                        <span>
                            پکیج طراحی سایت
                        </span>

                        <small>
                            ۲ ساعت پیش
                        </small>

                    </div>

                </div>


            </div>

        </div>

    </div>

</div>



<!-- =========================
     QUICK ACTIONS
========================== -->

<div class="quick-actions mt-4">

    <div class="quick-title">

        <h5>
            دسترسی سریع
        </h5>

        <span>
            کارهای پرکاربرد را سریع‌تر انجام دهید
        </span>

    </div>


    <div class="row g-3">


        <div class="col-md-3 col-6">

            <a asp-controller="Articles"
               asp-action="Create"
               class="quick-card">

                <div class="quick-icon purple">

                    <i class="bi bi-plus-circle"></i>

                </div>

                <span>
                    مقاله جدید
                </span>

            </a>

        </div>


        <div class="col-md-3 col-6">

            <a asp-controller="ArticleCategories"
               asp-action="Create"
               class="quick-card">

                <div class="quick-icon green">

                    <i class="bi bi-plus-circle"></i>

                </div>

                <span>
                    دسته‌بندی مقاله جدید
                </span>

            </a>

        </div>


        <div class="col-md-3 col-6">

            <a asp-controller="Product"
               asp-action="Create"
               class="quick-card">

                <div class="quick-icon purple">

                    <i class="bi bi-box-seam"></i>

                </div>

                <span>
                    محصول جدید
                </span>

            </a>

        </div>


        <div class="col-md-3 col-6">

            <a asp-controller="ProductCategories"
               asp-action="Create"
               class="quick-card">

                <div class="quick-icon green">

                    <i class="bi bi-box-seam"></i>

                </div>

                <span>
                    دسته‌بندی محصول جدید
                </span>

            </a>

        </div>

    </div>

</div>

<link rel="stylesheet"
