@using DigitalMarketing.Admin.Models

@model MainViewModel

@{
    ViewData["Title"] = "داشبورد";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet">

<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

<link rel="stylesheet" href="~/css/main/index.css" asp-append-version="true" />


<!-- =========================
     WELCOME
========================== -->

<div class="welcome-section">

    <div>

        <span class="welcome-label">
            خوش آمدید 👋
        </span>

        <h1>
            داشبورد مدیریت
        </h1>

        <p>
            وضعیت کلی سیستم را از اینجا مدیریت و بررسی کنید.
        </p>

    </div>

    <a asp-controller="Articles" asp-action="Create" class="create-article-btn">
        <i class="bi bi-plus-circle-fill"></i>
        <span>مقاله جدید</span>
    </a>

</div>







<!-- =========================
     STATISTICS
========================== -->

<div class="row g-4 mb-4">

    <!-- Articles -->
    <div class="col-xl-3 col-md-6">

        <div class="stat-card">

            <div class="stat-top">

                <div class="stat-icon purple">
                    <i class="bi bi-file-earmark-text"></i>
                </div>

                <span class="growth @(Model.ArticlesGrowthPercent >= 0 ? "positive" : "negative")">

                    <i class="bi @(Model.ArticlesGrowthPercent >= 0
                                               ? "bi-arrow-up"
                                               : "bi-arrow-down")"></i>

                    @Math.Abs(Model.ArticlesGrowthPercent)%

                </span>

            </div>

            <div class="stat-info">

                <span>
                    تعداد مقالات
                </span>

                <h2>
                    @Model.ArticlesCount
                </h2>

            </div>

            <div class="stat-footer">

                <span>
                    <i class="bi bi-file-text"></i>
                    مقالات ثبت شده
                </span>

            </div>

        </div>

    </div>


    <!-- Products -->
    <div class="col-xl-3 col-md-6">

        <div class="stat-card">

            <div class="stat-top">

                <div class="stat-icon green">
                    <i class="bi bi-box-seam"></i>
                </div>

                <span class="growth @(Model.ProductsGrowthPercent >= 0 ? "positive" : "negative")">

                    <i class="bi @(Model.ProductsGrowthPercent >= 0
                                               ? "bi-arrow-up"
                                               : "bi-arrow-down")"></i>

                    @Math.Abs(Model.ProductsGrowthPercent)%

                </span>

            </div>

            <div class="stat-info">

                <span>
                    تعداد محصولات
                </span>

                <h2>
                    @Model.ProductsCount
                </h2>

            </div>

            <div class="stat-footer">

                <span>
                    <i class="bi bi-box"></i>
                    محصولات ثبت شده
                </span>

            </div>

        </div>

    </div>


    <!-- Draft Articles -->
    <div class="col-xl-3 col-md-6">

        <div class="stat-card">

            <div class="stat-top">

                <div class="stat-icon orange">
                    <i class="bi bi-file-earmark"></i>
                </div>

            </div>

            <div class="stat-info">

                <span>
                    مقالات پیش‌نویس
                </span>

                <h2>
                    @Model.DraftArticlesCount
                </h2>

            </div>

            <div class="stat-footer">

                @if (Model.DraftArticlesCount > 0)
                {
                    <span class="text-warning">

                        <i class="bi bi-exclamation-circle"></i>

                        @Model.DraftArticlesCount مقاله
                        نیاز به انتشار دارد

                    </span>
                }
                else
                {
                    <span class="text-success">

                        <i class="bi bi-check-circle"></i>

                        همه مقالات منتشر شده‌اند

                    </span>
                }

            </div>

        </div>

    </div>


    <!-- Draft Products -->
    <div class="col-xl-3 col-md-6">

        <div class="stat-card">

            <div class="stat-top">

                <div class="stat-icon blue">
                    <i class="bi bi-box"></i>
                </div>

            </div>

            <div class="stat-info">

                <span>
                    محصولات منتشر نشده
                </span>

                <h2>
                    @Model.DraftProductsCount
                </h2>

            </div>

            <div class="stat-footer">

                @if (Model.DraftProductsCount > 0)
                {
                    <span class="text-warning">

                        <i class="bi bi-exclamation-circle"></i>

                        @Model.DraftProductsCount محصول
                        نیاز به عرضه دارد

                    </span>
                }
                else
                {
                    <span class="text-success">

                        <i class="bi bi-check-circle"></i>

                        همه محصولات عرضه شده‌اند

                    </span>
                }

            </div>

        </div>

    </div>

</div>







<!-- =========================
     CONTENT
========================== -->

<div class="row g-4">


    <!-- Articles -->

    <div class="col-xl-8">

        <div class="dashboard-card">

            <div class="card-header-custom">

                <div>

                    <h5>
                        آخرین مقالات
                    </h5>

                    <span>
                        مقالات اخیراً ایجاد یا ویرایش شده
                    </span>

                </div>

                <a asp-controller="Articles"
                   asp-action="Index">

                    مشاهده همه

                    <i class="bi bi-arrow-left"></i>

                </a>

            </div>


            <div class="table-responsive">

                <table class="table custom-table align-middle">

                    <thead>

                        <tr>

                            <th>
                                عنوان مقاله
                            </th>

                            <th>
                                دسته‌بندی
                            </th>

                            <th>
                                وضعیت
                            </th>

                            <th>
                                تاریخ
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var article in Model.LatestArticles)
                        {
                            <tr>

                                <td>

                                    <div class="article-title">

                                        <div class="article-icon">
                                            <i class="bi bi-file-text"></i>
                                        </div>

                                        <div>

                                            <strong>@article.Title</strong>

                                            <small>
                                                شناسه: #@article.Id
                                            </small>

                                        </div>

                                    </div>

                                </td>

                                <td>

                                    <span class="category">
                                        @article.ArticleCategoryName
                                    </span>

                                </td>

                                <td>

                                    @if (article.IsPublished)
                                    {
                                        <span class="status published">
                                            منتشر شده
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status draft">
                                            پیش نویس
                                        </span>
                                    }

                                </td>

                                <td>

                                    <span class="date">
                                        @article.CreatedAt.ToString("yyyy/MM/dd")
                                    </span>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>



    <!-- Products -->

    <div class="col-xl-4">

        <div class="dashboard-card activity-card">

            <div class="card-header-custom">

                <div>
                    <h5>آخرین محصولات</h5>
                    <span>جدیدترین محصولات ثبت شده</span>
                </div>

                <a asp-controller="Product" asp-action="Index">
                    مشاهده همه
                    <i class="bi bi-arrow-left"></i>
                </a>

            </div>

            <div class="product-list">

                @foreach (var product in Model.LatestProducts)
                {
                    <div class="product-item">

                        @if (product.Images.Any(x => x.IsMain))
                        {
                            <img src="@product.Images.First(x => x.IsMain).ImageUrl"
                                 alt="@product.Title" />
                        }
                        else
                        {
                            <div class="product-placeholder">
                                <i class="bi bi-image"></i>
                            </div>
                        }

                        <div class="product-info">

                            <strong>@product.Title</strong>

                            <span>@product.ProductCategoryNAme</span>

                            <small>
                                @product.CreatedAt.ToString("yyyy/MM/dd")
                            </small>

                        </div>

                    </div>
                }

            </div>


        </div>

    </div>

</div>





<!-- =========================
     QUICK ACTIONS
========================== -->

<div class="quick-actions mt-4">

    <div class="quick-title">

        <h5>
            دسترسی سریع
        </h5>

        <span>
            کارهای پرکاربرد را سریع‌تر انجام دهید
        </span>

    </div>



    <div class="row g-3">

        <!-- Create Article -->
        <div class="col-md-3 col-6">

            <a asp-controller="Articles"
               asp-action="Create"
               class="quick-card">

                <div class="quick-icon purple">

                    <i class="bi bi-plus-circle"></i>

                </div>

                <span>
                    مقاله جدید
                </span>

            </a>

        </div>



        <!-- Create Article Category -->
        <div class="col-md-3 col-6">

            <a asp-controller="ArticleCategories"
               asp-action="Create"
               class="quick-card">

                <div class="quick-icon green">

                    <i class="bi bi-plus-circle"></i>

                </div>

                <span>
                    دسته‌بندی مقاله جدید
                </span>

            </a>

        </div>




        <!-- Create Product -->
        <div class="col-md-3 col-6">

            <a asp-controller="Product"
               asp-action="Create"
               class="quick-card">

                <div class="quick-icon purple">

                    <i class="bi bi-box-seam"></i>

                </div>

                <span>
                    محصول جدید
                </span>

            </a>

        </div>



        <!-- Create Product Category -->
        <div class="col-md-3 col-6">

            <a asp-controller="ProductCategories"
               asp-action="Create"
               class="quick-card">

                <div class="quick-icon green">

                    <i class="bi bi-box-seam"></i>

                </div>

                <span>
                    دسته‌بندی محصول جدید
                </span>

            </a>

        </div>

    </div>

</div>




<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">