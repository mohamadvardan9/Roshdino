@using DigitalMarketing.DigitalMarketing.Services.DTOs.ArticleDtos
@model List<ArticleDto>

@{
    ViewData["Title"] = "مقالات";
}

<h2>مقالات</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<a asp-action="Create" class="btn btn-primary mb-3">+ مقاله جدید</a>

<table class="table table-bordered align-middle">
    <thead>
        <tr>
            <th>تصویر شاخص</th>
            <th>عنوان</th>
            <th>دسته‌بندی</th>
            <th>تاریخ انتشار</th>
            <th>وضعیت</th>
            <th>عملیات</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var article in Model)
        {
            <tr>
                <td>
                    @if (!string.IsNullOrEmpty(article.CoverImageUrl))
                    {
                        <img src="@article.CoverImageUrl" width="60" height="60" style="object-fit:cover" />
                    }
                    else
                    {
                        <span class="text-muted">بدون تصویر</span>
                    }
                </td>
                <td>@article.Title</td>
                <td>@article.ArticleCategoryName</td>
                <td>@article.PublishedAt.ToString("yyyy/MM/dd")</td>
                <td>
                    @if (article.IsPublished)
                    {
                        <span class="badge bg-success">منتشرشده</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">پیش‌نویس</span>
                    }
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@article.Id" class="btn btn-sm btn-secondary">ویرایش</a>

                    <form asp-action="TogglePublish" asp-route-id="@article.Id" method="post" style="display:inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-primary">
                            @(article.IsPublished ? "پیش‌نویس کن" : "منتشر کن")
                        </button>
                    </form>

                    <form asp-action="Delete" asp-route-id="@article.Id" method="post" style="display:inline"
                          onsubmit="return confirm('مطمئنی می‌خوای این مقاله رو حذف کنی؟');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-danger">حذف</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>