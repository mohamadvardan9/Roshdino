@using DigitalMarketing.DigitalMarketing.Services.DTOs.ArticleCategoryDtos
@using DigitalMarketing.DigitalMarketing.Services.DTOs.ArticleDtos

@model UpdateArticleDto

@{
    ViewData["Title"] = "ویرایش مقاله";

    var categories = ViewBag.Categories as List<ArticleCategoryDto>;
    var currentCover = ViewBag.CurrentCoverImage as string;
}

<div class="edit-article-page">

    <!-- =========================
         Header
    ========================== -->

    <div class="edit-article-header">

        <div>

            <div class="edit-breadcrumb">

                <a asp-action="Index">
                    مقالات
                </a>

                <i class="bi bi-chevron-left"></i>

                <span>ویرایش مقاله</span>

            </div>

            <h1>
                ویرایش مقاله
            </h1>

            <p>
                اطلاعات مقاله را ویرایش و تغییرات را ذخیره کنید.
            </p>

        </div>


        <a asp-action="Index"
           class="edit-back-btn">

            <i class="bi bi-arrow-right"></i>

            بازگشت به مقالات

        </a>

    </div>


    <!-- =========================
         Validation
    ========================== -->

    <div asp-validation-summary="ModelOnly"
         class="edit-validation-summary">
    </div>


    <!-- =========================
         Form
    ========================== -->

    <form asp-action="Edit"
          asp-route-id="@Model.Id"
          method="post"
          enctype="multipart/form-data">

        @Html.AntiForgeryToken()

        <input asp-for="Id" type="hidden" />


        <div class="edit-article-layout">


            <!-- =========================
                 Main Column
            ========================== -->

            <div class="edit-main-column">


                <!-- Article Information -->

                <div class="edit-card">

                    <div class="edit-card-header">

                        <div class="edit-card-icon blue">
                            <i class="bi bi-file-earmark-text"></i>
                        </div>

                        <div>
                            <h3>
                                اطلاعات مقاله
                            </h3>

                            <p>
                                عنوان، خلاصه و محتوای مقاله
                            </p>
                        </div>

                    </div>


                    <div class="edit-card-body">


                        <!-- Title -->

                        <div class="edit-form-group">

                            <label asp-for="Title">
                                عنوان مقاله
                                <span>*</span>
                            </label>

                            <input asp-for="Title"
                                   class="edit-input"
                                   placeholder="عنوان مقاله را وارد کنید..."
                                   data-val="true"
                                   data-val-required="عنوان مقاله الزامی است" />

                            <span asp-validation-for="Title"
                                  class="edit-field-error">
                            </span>

                        </div>


                        <!-- Summary -->

                        <div class="edit-form-group">

                            <div class="edit-label-row">

                                <label asp-for="Summary">
                                    خلاصه مقاله
                                    <span>*</span>
                                </label>

                                <span>
                                    توضیح کوتاه مقاله
                                </span>

                            </div>

                            <textarea asp-for="Summary"
                                      class="edit-textarea edit-summary"
                                      rows="4"
                                      placeholder="خلاصه مقاله را وارد کنید..."
                                      data-val="true"
                                      data-val-required="خلاصه برای مقاله الزامی است"></textarea>

                            <span asp-validation-for="Summary"
                                  class="edit-field-error">
                            </span>

                        </div>


                        <!-- Content -->

                        <div class="edit-form-group">

                            <div class="edit-label-row">

                                <label asp-for="Content">
                                    محتوای مقاله
                                    <span>*</span>
                                </label>

                                <span>
                                    متن کامل مقاله
                                </span>

                            </div>


                            <div class="edit-editor-container">

                                <textarea asp-for="Content"
                                          id="ContentEditor"
                                          class="edit-content-textarea">
                                </textarea>

                            </div>


                            <span asp-validation-for="Content"
                                  class="edit-field-error">
                            </span>

                        </div>

                    </div>

                </div>


                <!-- Category -->

                <div class="edit-card">

                    <div class="edit-card-header">

                        <div class="edit-card-icon purple">
                            <i class="bi bi-folder2-open"></i>
                        </div>

                        <div>

                            <h3>
                                دسته‌بندی
                            </h3>

                            <p>
                                دسته‌بندی مقاله را مشخص کنید.
                            </p>

                        </div>

                    </div>


                    <div class="edit-card-body">

                        <div class="edit-form-group">

                            <label asp-for="ArticleCategoryId">
                                دسته‌بندی
                                <span>*</span>
                            </label>

                            <select asp-for="ArticleCategoryId"
                                    class="edit-select"
                                    data-val="true"
                                    data-val-required="دسته بندی مقاله الزامی است">

                                <option value="">
                                    انتخاب دسته‌بندی
                                </option>

                                @if (categories != null)
                                {
                                    foreach (var category in categories)
                                    {
                                        <option value="@category.Id">
                                            @category.Name
                                        </option>
                                    }
                                }

                            </select>

                            <span asp-validation-for="ArticleCategoryId"
                                  class="edit-field-error">
                            </span>

                        </div>

                    </div>

                </div>


                <!-- Publishing Status -->

                <div class="edit-card">

                    <div class="edit-card-header">

                        <div class="edit-card-icon green">
                            <i class="bi bi-broadcast"></i>
                        </div>

                        <div>

                            <h3>
                                وضعیت انتشار
                            </h3>

                            <p>
                                وضعیت نمایش مقاله در سایت را انتخاب کنید.
                            </p>

                        </div>

                    </div>


                    <div class="edit-card-body">

                        <label class="publish-switch">

                            <div class="publish-switch-content">

                                <div class="publish-status-icon
                                    @(Model.IsPublished ? "published" : "draft")"
                                     id="publishStatusIcon">

                                    <i class="bi @(Model.IsPublished? "bi-eye": "bi-eye-slash")"
                                       id="publishStatusIconGlyph">
                                    </i>

                                </div>

                                <div>

                                    <strong id="publishStatusText">
                                        @(Model.IsPublished
                                            ? "مقاله منتشر شده است"
                                            : "مقاله به صورت پیش‌نویس است")
                                    </strong>

                                    <span id="publishDescription">
                                        @(Model.IsPublished
                                            ? "این مقاله در سایت برای کاربران قابل مشاهده است."
                                            : "این مقاله در سایت عمومی نمایش داده نمی‌شود.")
                                    </span>

                                </div>

                            </div>


                            <input asp-for="IsPublished"
                                   type="checkbox"
                                   id="isPublished" />

                            <span class="custom-switch"></span>

                        </label>

                    </div>

                </div>

            </div>


            <!-- =========================
                 Sidebar
            ========================== -->

            <div class="edit-sidebar">


                <!-- Cover -->

                <div class="cover-editor">

                    <input type="file"
                           asp-for="NewCoverImage"
                           id="newCoverImage"
                           accept=".jpg,.jpeg,.png,.webp" />

                    <!-- Current / Preview Image -->

                    <div class="cover-preview" id="coverPreview">

                        @if (!string.IsNullOrEmpty(currentCover))
                        {
                            <img id="coverPreviewImage"
                                 src="@currentCover"
                                 alt="تصویر شاخص مقاله" />

                            <button type="button"
                                    class="image-delete-btn"
                                    id="removePreview"
                                    title="حذف تصویر">
                                <i class="bi bi-x"></i>
                            </button>
                        }
                        else
                        {
                            <div class="no-cover" id="noCover">
                                <i class="bi bi-image"></i>
                                <span>تصویر شاخص وجود ندارد</span>
                            </div>
                        }

                    </div>


                    <!-- Upload -->

                    <label for="newCoverImage" class="change-cover-btn">
                        <i class="bi bi-cloud-arrow-up"></i>
                        انتخاب تصویر جدید
                    </label>

                    <p class="cover-hint">
                        فرمت‌های مجاز: JPG، PNG، WEBP
                    </p>

                </div>



                <!-- Article Info -->

                <div class="edit-card">

                    <div class="edit-card-header">

                        <div class="edit-card-icon gray">
                            <i class="bi bi-info-circle"></i>
                        </div>

                        <div>

                            <h3>
                                اطلاعات
                            </h3>

                            <p>
                                وضعیت فعلی مقاله
                            </p>

                        </div>

                    </div>


                    <div class="article-info-list">

                        <div class="article-info-item">

                            <span>
                                شناسه مقاله
                            </span>

                            <strong>
                                #@Model.Id
                            </strong>

                        </div>


                        <div class="article-info-item">

                            <span>
                                وضعیت
                            </span>

                            <strong class="info-status
                                @(Model.IsPublished ? "active" : "inactive")"
                                    id="infoStatusBadge">

                                @(Model.IsPublished
                                    ? "منتشرشده"
                                    : "پیش‌نویس")

                            </strong>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- =========================
             Bottom Actions
        ========================== -->

        <div class="edit-actions">

            <a asp-action="Index"
               class="edit-cancel-btn">

                انصراف

            </a>


            <button type="submit"
                    class="edit-save-btn">

                <i class="bi bi-check-lg"></i>

                ذخیره تغییرات

            </button>

        </div>

    </form>

</div>


@section Styles {

    <link rel="stylesheet"
          href="~/css/article/article-edit.css"
          asp-append-version="true" />

}



@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script src="https://cdn.ckeditor.com/ckeditor5/41.4.2/classic/ckeditor.js"></script>


    <script>


        ClassicEditor
        .create(document.querySelector('#ContentEditor'))
        .catch(error => {
        console.error(error);
        });



        const coverInput = document.getElementById("newCoverImage");
        const coverPreview = document.getElementById("coverPreview");

        const removeUrl =
            '@Url.Action("RemoveImage", "Articles")';

        const currentCoverUrl = @Html.Raw(
                    string.IsNullOrEmpty(currentCover)
                            ? "null"
                            : System.Text.Json.JsonSerializer.Serialize(currentCover));

        let hasPendingNewFile = false;


        // ==============================
        // Select New Image
        // ==============================

        coverInput.addEventListener("change", function () {

            const file = this.files[0];

            if (!file)
                return;

            hasPendingNewFile = true;

            const reader = new FileReader();

            reader.onload = function (e) {

                coverPreview.innerHTML = `
                    <img
                        id="coverPreviewImage"
                        src="${e.target.result}"
                        alt="تصویر جدید"
                    />

                    <button
                        type="button"
                        class="image-delete-btn"
                        id="removePreview"
                        title="لغو انتخاب">

                        <i class="bi bi-x"></i>

                    </button>
                `;

                attachRemoveHandler();
            };

            reader.readAsDataURL(file);
        });


        // ==============================
        // Remove Button
        // ==============================

        function attachRemoveHandler() {

            const removeBtn =
                document.getElementById("removePreview");

            if (!removeBtn)
                return;


            removeBtn.addEventListener("click", async function () {


                // ==============================
                // 1. New selected image
                // ==============================

                if (hasPendingNewFile) {

                    coverInput.value = "";

                    hasPendingNewFile = false;

                    if (currentCoverUrl) {

                        coverPreview.innerHTML = `
                            <img
                                id="coverPreviewImage"
                                src="${currentCoverUrl}"
                                alt="تصویر شاخص مقاله"
                            />

                            <button
                                type="button"
                                class="image-delete-btn"
                                id="removePreview"
                                title="حذف تصویر">

                                <i class="bi bi-x"></i>

                            </button>
                        `;

                    } else {

                        coverPreview.innerHTML = `
                            <div class="no-cover" id="noCover">

                                <i class="bi bi-image"></i>

                                <span>
                                    تصویر شاخص وجود ندارد
                                </span>

                            </div>
                        `;
                    }

                    attachRemoveHandler();

                    return;
                }


                // ==============================
                // 2. Delete existing image
                // ==============================

                const confirmed = confirm(
                    "مطمئنی می‌خوای تصویر شاخص حذف بشه؟"
                );

                if (!confirmed)
                    return;


                const tokenInput =
                    document.querySelector(
                        'input[name="__RequestVerificationToken"]'
                    );


                if (!tokenInput) {

                    alert("توکن امنیتی پیدا نشد.");

                    return;
                }


                try {

                    const response = await fetch(removeUrl, {

                        method: "POST",

                        headers: {
                            "Content-Type":
                                "application/x-www-form-urlencoded"
                        },

                        body: new URLSearchParams({

                            articleId: "@Model.Id",

                            __RequestVerificationToken:
                                tokenInput.value
                        })
                    });


                    if (response.ok) {

                        location.reload();

                    }
                    else {

                        const errorText =
                            await response.text();

                        console.error(errorText);

                        alert(
                            "حذف تصویر با خطا مواجه شد."
                        );
                    }

                }
                catch (error) {

                    console.error(error);

                    alert(
                        "ارتباط با سرور برقرار نشد."
                    );
                }

            });
        }


        // ==============================
        // Initial Handler
        // ==============================

        attachRemoveHandler();


        // ==============================
        // Live-update Publish Switch
        // (this was missing — the label
        // text/icon/badge used to stay
        // stale until the page reloaded)
        // ==============================

        const isPublishedInput = document.getElementById("isPublished");
        const publishStatusText = document.getElementById("publishStatusText");
        const publishDescription = document.getElementById("publishDescription");
        const publishStatusIcon = document.getElementById("publishStatusIcon");
        const publishStatusIconGlyph = document.getElementById("publishStatusIconGlyph");
        const infoStatusBadge = document.getElementById("infoStatusBadge");

        isPublishedInput.addEventListener("change", function () {

            const isPublished = this.checked;

            publishStatusText.textContent = isPublished
                ? "مقاله منتشر شده است"
                : "مقاله به صورت پیش‌نویس است";

            publishDescription.textContent = isPublished
                ? "این مقاله در سایت برای کاربران قابل مشاهده است."
                : "این مقاله در سایت عمومی نمایش داده نمی‌شود.";

            publishStatusIcon.classList.toggle("published", isPublished);
            publishStatusIcon.classList.toggle("draft", !isPublished);

            publishStatusIconGlyph.classList.toggle("bi-eye", isPublished);
            publishStatusIconGlyph.classList.toggle("bi-eye-slash", !isPublished);

            infoStatusBadge.classList.toggle("active", isPublished);
            infoStatusBadge.classList.toggle("inactive", !isPublished);
            infoStatusBadge.textContent = isPublished ? "منتشرشده" : "پیش‌نویس";
        });

    </script>
}
