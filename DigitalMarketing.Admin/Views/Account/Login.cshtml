@using DigitalMarketing.Services.DigitalMarketing.Services.DTOs.AdminUserDtos
@model LoginDto
@{
    ViewData["Title"] = "ورود به پنل مدیریت";
    Layout = "_LoginLayout"; // یه Layout ساده و جدا، بدون Navbar/Sidebar پنل ادمین
}

<div class="login-box">
    <h2>ورود به پنل مدیریت</h2>

    <div asp-validation-summary="All" class="text-danger"></div>

    <form asp-action="Login" method="post">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label asp-for="UserName" class="form-label">نام کاربری</label>
            <input asp-for="UserName" class="form-control" autofocus />
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label">رمز عبور</label>
            <input asp-for="Password" type="password" class="form-control" />
        </div>

        <button type="submit" class="btn btn-primary w-100">ورود</button>
    </form>
</div>