@using DigitalMarketing.Services.DigitalMarketing.Services.DTOs.AdminUserDtos
@model ChangePasswordDto


@{
    ViewData["Title"] = "تغییر رمز عبور";
}

<div class="dashboard-content">

    <div class="page-header">

        <div>
            <span class="page-badge">
                <i class="bi bi-shield-lock-fill"></i>
                امنیت حساب
            </span>

            <h1>تغییر رمز عبور</h1>

            <p>
                برای حفظ امنیت پنل مدیریت، رمز عبور جدید و قدرتمندی انتخاب کنید.
            </p>
        </div>

    </div>


    <div class="page-card">

        @if (TempData["Success"] != null)
        {
            <div class="custom-alert success">
                <i class="bi bi-check-circle-fill"></i>
                <span>@TempData["Success"]</span>
            </div>
        }

        <div asp-validation-summary="ModelOnly"
             class="custom-alert danger">
        </div>


        <form asp-action="ChangePassword" method="post">

            @Html.AntiForgeryToken()

            <div class="row">

                <!-- Current Password -->

                <div class="col-lg-6">

                    <div class="form-group">

                        <label asp-for="CurrentPassword">
                            رمز عبور فعلی
                            <span>*</span>
                        </label>

                        <div class="input-icon">

                            <i class="bi bi-lock-fill"></i>

                            <input asp-for="CurrentPassword"
                                   type="password"
                                   class="form-control"
                                   placeholder="رمز عبور فعلی" />

                        </div>

                    </div>

                </div>


                <!-- New Password -->

                <div class="col-lg-6">

                    <div class="form-group">

                        <label asp-for="NewPassword">
                            رمز عبور جدید
                            <span>*</span>
                        </label>

                        <div class="input-icon">

                            <i class="bi bi-key-fill"></i>

                            <input asp-for="NewPassword"
                                   type="password"
                                   class="form-control"
                                   placeholder="رمز عبور جدید" />

                        </div>

                        <small>
                            حداقل ۸ کاراکتر شامل حروف و اعداد
                        </small>

                    </div>

                </div>

            </div>


            <div class="password-tips">

                <div class="tip">
                    <i class="bi bi-check2-circle"></i>
                    از رمزهای تکراری استفاده نکنید.
                </div>

                <div class="tip">
                    <i class="bi bi-check2-circle"></i>
                    ترکیبی از حروف بزرگ، کوچک و اعداد انتخاب کنید.
                </div>

            </div>


            <div class="page-actions">

                <a asp-controller="Main"
                   asp-action="Index"
                   class="btn-cancel">

                    <i class="bi bi-arrow-right"></i>
                    بازگشت

                </a>

                <button type="submit"
                        class="btn-save">

                    <i class="bi bi-check-lg"></i>
                    ذخیره رمز جدید

                </button>

            </div>

        </form>

    </div>

</div>



@section Styles {

    <link rel="stylesheet"
          href="~/css/account/changePassword.css"
          asp-append-version="true" />

}