@using DigitalMarketing.DigitalMarketing.Services.DTOs.ProductCategoryDtos
@model List<ProductCategoryDto>

@{
    ViewData["Title"] = "دسته‌بندی محصولات";
}

<div class="categories-page">

    <!-- =========================
         Header
    ========================== -->

    <div class="categories-header">

        <div>

            <h1>
                دسته‌بندی محصولات
            </h1>

            <p>
                دسته‌بندی‌های محصولات سایت را مدیریت و سازماندهی کنید.
            </p>

        </div>


        <a asp-action="Create"
           class="add-category-btn">

            <i class="bi bi-plus-lg"></i>

            دسته‌بندی جدید

        </a>

    </div>


    <!-- =========================
         Alerts
    ========================== -->
    @if (TempData["Success"] != null)
    {
        <div class="category-alert success">

            <div class="alert-icon">
                <i class="bi bi-check-lg"></i>
            </div>

            <div>
                <strong>عملیات موفق</strong>

                <span>
                    @TempData["Success"]
                </span>
            </div>

        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="category-alert error">

            <div class="alert-icon">
                <i class="bi bi-exclamation-lg"></i>
            </div>

            <div>
                <strong>خطا</strong>

                <span>
                    @TempData["Error"]
                </span>
            </div>

        </div>
    }


    <!-- =========================
         Stats
    ========================== -->

    <div class="category-stats">

        <div class="category-stat-card">

            <div class="stat-icon blue">
                <i class="bi bi-folder2-open"></i>
            </div>

            <div class="stat-content">

                <span>
                    کل دسته‌بندی‌ها
                </span>

                <strong>
                    @(Model?.Count ?? 0)
                </strong>

            </div>

        </div>


        <div class="category-stat-card">

            <div class="stat-icon purple">
                <i class="bi bi-collection"></i>
            </div>

            <div class="stat-content">

                <span>
                    مدیریت دسته‌بندی
                </span>

                <strong>
                    آسان
                </strong>

            </div>

        </div>


        <div class="category-stat-card">

            <div class="stat-icon green">
                <i class="bi bi-check-circle"></i>
            </div>

            <div class="stat-content">

                <span>
                    وضعیت سیستم
                </span>

                <strong class="system-active">
                    فعال
                </strong>

            </div>

        </div>

    </div>


    <!-- =========================
         Categories Table
    ========================== -->

    <div class="categories-card">

        <div class="categories-card-header">

            <div class="categories-title">

                <div class="table-title-icon">
                    <i class="bi bi-folder"></i>
                </div>

                <div>

                    <h2>
                        لیست دسته‌بندی‌ها
                    </h2>

                    <p>
                        تمام دسته‌بندی‌های محصولات سایت
                    </p>

                </div>

            </div>


            <div class="category-count">

                <span>
                    تعداد
                </span>

                <strong>
                    @(Model?.Count ?? 0)
                </strong>

            </div>

        </div>


        @if (Model != null && Model.Any())
        {
            <div class="categories-table-wrapper">

                <table class="categories-table">

                    <thead>

                        <tr>

                            <th class="id-column">
                                #
                            </th>

                            <th>
                                نام دسته‌بندی
                            </th>

                            <th>
                                آخرین آپدیت
                            </th>

                            <th>
                                ساخته شده
                            </th>

                            <th class="actions-column">
                                عملیات
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var category in Model)
                        {
                            <tr>

                                <!-- ID -->

                                <td class="id-cell">

                                    <span>
                                        #@category.Id
                                    </span>

                                </td>


                                <!-- Category Name -->

                                <td>

                                    <div class="category-name-cell">

                                        <div class="category-avatar">
                                            <i class="bi bi-folder-fill"></i>
                                        </div>

                                        <div>

                                            <strong>
                                                @category.Name
                                            </strong>

                                            <span>
                                                @category.Slug
                                            </span>

                                        </div>

                                    </div>

                                </td>


                                <!-- Update Date -->

                                <td data-label="بروزرسانی">

                                    @if (category.UpdatedAt == null)
                                    {
                                        <span class="not-updated">
                                            هنوز بروزرسانی نشده
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="updated-date">
                                            @category.UpdatedAt.Value.ToString("yyyy/MM/dd")
                                        </span>
                                    }

                                </td>


                                <!-- Create Date -->

                                <td data-label="ساخته شده">

                                    <span class="updated-date">
                                        @category.CreatedAt.ToString("yyyy/MM/dd")
                                    </span>

                                </td>


                                <!-- Actions -->

                                <td>

                                    <div class="category-actions">

                                        <a asp-action="Edit"
                                           asp-route-id="@category.Id"
                                           class="category-action edit"
                                           title="ویرایش">

                                            <i class="bi bi-pencil"></i>

                                            <span>
                                                ویرایش
                                            </span>

                                        </a>


                                        <form asp-action="Delete"
                                              asp-route-id="@category.Id"
                                              method="post"
                                              class="delete-category-form">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="category-action delete"
                                                    title="حذف">

                                                <i class="bi bi-trash3"></i>

                                                <span>
                                                    حذف
                                                </span>

                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <!-- Empty State -->

            <div class="categories-empty">

                <div class="empty-icon">
                    <i class="bi bi-folder-x"></i>
                </div>

                <h3>
                    هنوز دسته‌بندی‌ای ایجاد نشده است
                </h3>

                <p>
                    برای سازماندهی بهتر محصولات، اولین دسته‌بندی خود را ایجاد کنید.
                </p>

                <a asp-action="Create"
                   class="empty-create-btn">

                    <i class="bi bi-plus-lg"></i>

                    ایجاد اولین دسته‌بندی

                </a>

            </div>
        }

    </div>

</div>


@section Styles {
    <link rel="stylesheet"
          href="~/css/product-category/product-category.css"
          asp-append-version="true" />
}


@section Scripts {

    <script>

        document.querySelectorAll(".delete-category-form")
            .forEach(form => {

                form.addEventListener("submit", function (e) {

                    const confirmed = confirm(
                        "مطمئنی می‌خوای این دسته‌بندی رو حذف کنی؟"
                    );

                    if (!confirmed) {
                        e.preventDefault();
                    }

                });

            });

    </script>

}