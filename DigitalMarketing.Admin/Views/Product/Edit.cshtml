@using DigitalMarketing.DigitalMarketing.Services.DTOs.ProductCategoryDtos
@using DigitalMarketing.DigitalMarketing.Services.DTOs.ProductDtos



@model UpdateProductDto

@{
    ViewData["Title"] = "ویرایش محصول";
    var categories = ViewBag.Categories as List<ProductCategoryDto>;
    var existingImages = ViewBag.ExistingImages as List<ProductImageDto>;
}

<h2>ویرایش محصول</h2>

<div asp-validation-summary="All" class="text-danger"></div>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="Title" class="form-label">عنوان محصول</label>
        <input asp-for="Title" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="ShortDescription" class="form-label">توضیح کوتاه</label>
        <textarea asp-for="ShortDescription" class="form-control" rows="2"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label">توضیحات کامل</label>
        <textarea asp-for="Description" class="form-control" rows="6"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="Price" class="form-label">قیمت (اختیاری)</label>
        <input asp-for="Price" class="form-control" type="number" step="0.01" />
    </div>

    <div class="mb-3">
        <label asp-for="ProductCategoryId" class="form-label">دسته‌بندی</label>
        <select asp-for="ProductCategoryId" class="form-select">
            @if (categories != null)
            {
                @foreach (var category in categories)
                {
                    <option value="@category.Id" selected="@(category.Id == Model.ProductCategoryId)">
                        @category.Name
                    </option>
                }
            }
        </select>
    </div>

    <div class="form-check mb-3">
        <input asp-for="IsPublished" class="form-check-input" type="checkbox" />
        <label asp-for="IsPublished" class="form-check-label">منتشر شود</label>
    </div>

    <div class="mb-3">
        <label class="form-label">تصاویر جدید (افزودن)</label>
        <input type="file" name="newImages" multiple accept=".jpg,.jpeg,.png,.webp" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">ذخیره تغییرات</button>
    <a asp-action="Index" class="btn btn-secondary">انصراف</a>
</form>

<hr />

<h4>تصاویر فعلی</h4>
<div class="d-flex flex-wrap gap-3">
    @if (existingImages != null)
    {
        @foreach (var image in existingImages)
        {
            <div class="border p-2 text-center" style="width:150px">
                <img src="@image.ImageUrl" width="130" height="130" style="object-fit:cover" />

                @if (image.IsMain)
                {
                    <div class="badge bg-primary mt-1">تصویر اصلی</div>
                }
                else
                {
                    <form asp-action="SetMainImage" method="post" class="mt-1">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="imageId" value="@image.Id" />
                        <input type="hidden" name="productId" value="@Model.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-primary">
                            تصویر اصلی کن
                        </button>
                    </form>
                }

                <form asp-action="RemoveImage" method="post" class="mt-1"
                      onsubmit="return confirm('این تصویر حذف شود؟');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="imageId" value="@image.Id" />
                    <input type="hidden" name="productId" value="@Model.Id" />
                    <button type="submit" class="btn btn-sm btn-danger">حذف</button>
                </form>
            </div>
        }
    }
    else
    {
        <p class="text-muted">هیچ تصویری ثبت نشده.</p>
    }
</div>