@using DigitalMarketing.DigitalMarketing.Services.DTOs.ArticleDtos
@model ArticleDto

@{
    ViewData["Title"] = Model.Title;
    ViewData["Description"] = Model.Summary;

    if (!string.IsNullOrEmpty(Model.CoverImageUrl))
    {
        ViewData["Image"] = Model.CoverImageUrl;
    }
}



<section class="article-details-hero">


    <div class="container">


        <div class="article-breadcrumb">


            <a asp-controller="Home"
               asp-action="Index">

                خانه

            </a>


            <i class="bi bi-chevron-left"></i>


            <a asp-controller="Article"
               asp-action="Index">

                مقالات

            </a>


            <i class="bi bi-chevron-left"></i>


            <span>

                @Model.Title

            </span>


        </div>




        <div class="article-header">


            <span class="article-detail-category">

                <i class="bi bi-folder"></i>

                @Model.ArticleCategoryName

            </span>



            <h1>

                @Model.Title

            </h1>




            <div class="article-detail-meta">


                <span>

                    <i class="bi bi-calendar3"></i>

                    @Model.PublishedAt.ToString("yyyy/MM/dd")

                </span>


            </div>


        </div>


    </div>


</section>





<section class="section">


    <div class="container">


        <article class="article-single">


            @if (!string.IsNullOrEmpty(Model.CoverImageUrl))
            {

                <div class="article-cover">


                    <img src="@Model.CoverImageUrl"
                         alt="@Model.Title" />


                </div>

            }




            <div class="article-body">

                
                @Html.Raw(Model.Content)


            </div>



        </article>





        <div class="article-back">


            <a asp-controller="Article"
               asp-action="Index"
               class="btn btn-outline">


                <i class="bi bi-arrow-right"></i>

                بازگشت به مقالات


            </a>


        </div>




    </div>


</section>