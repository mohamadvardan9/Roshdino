@using DigitalMarketing.Web.Models
@model ArticleListViewModel

@{
    ViewData["Title"] = "مقالات";
    ViewData["Description"] = "آخرین مطالب آموزشی و اخبار حوزه دیجیتال مارکتینگ";
}

<section class="page-header">
    <div class="container text-center">
        <h1>مقالات و اخبار</h1>
        <p>آخرین مطالب آموزشی و اخبار حوزه دیجیتال مارکتینگ</p>
    </div>
</section>

<section class="section">
    <div class="container product-page-inner">

        <!-- Sidebar: Category Filter -->
        <aside class="product-sidebar">
            <h4>دسته‌بندی‌ها</h4>
            <ul class="category-filter">
                <li class="@(Model.SelectedCategoryId == null ? "active" : "")">
                    <a asp-controller="Article" asp-action="Index">همه مقالات</a>
                </li>
                @foreach (var category in Model.Categories)
                {
                    <li class="@(Model.SelectedCategoryId == category.Id ? "active" : "")">
                        <a asp-controller="Article" asp-action="Index" asp-route-categoryId="@category.Id">
                            @category.Name
                        </a>
                    </li>
                }
            </ul>
        </aside>

        <!-- Article Grid -->
        <div class="product-list">
            @if (Model.Articles.Any())
            {
                <div class="grid grid-3">
                    @foreach (var article in Model.Articles)
                    {
                        <a asp-controller="Article" asp-action="Details" asp-route-slug="@article.Slug" class="portfolio-card card">
                            <div class="portfolio-image">
                                @if (!string.IsNullOrEmpty(article.CoverImageUrl))
                                {
                                    <img src="@article.CoverImageUrl" alt="@article.Title" />
                                }
                                else
                                {
                                    <div class="portfolio-no-image">بدون تصویر</div>
                                }
                            </div>

                            <div class="portfolio-content">
                                <span class="portfolio-category">@article.ArticleCategoryName</span>
                                <h3>@article.Title</h3>
                                <p>@article.Summary</p>
                                <div class="article-date">@article.PublishedAt.ToString("yyyy/MM/dd")</div>
                            </div>
                        </a>
                    }
                </div>
            }
            else
            {
                <p class="text-center text-muted">مقاله‌ای در این دسته‌بندی یافت نشد.</p>
            }
        </div>

    </div>
</section>