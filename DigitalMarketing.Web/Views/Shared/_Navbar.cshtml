<nav class="navbar">
    <div class="container navbar-inner">

        <a asp-controller="Home" asp-action="Index" class="navbar-brand">
            <div class="brand-logo">
                <span>R</span>
            </div>
            <div class="brand-content">
                <span class="brand-content__title">Roshdino</span>
                <span class="brand-content__subtitle">دیجیتال مارکتینگ</span>
            </div>

        </a>

        <div class="navbar-menu" id="navbar-menu">
            <a asp-controller="Home" asp-action="Index">خانه</a>
            <a asp-controller="Product" asp-action="Index">محصولات</a>
            <a asp-controller="Article" asp-action="Index">مقالات</a>
            <a asp-controller="AboutUs" asp-action="Index">درباره ما</a>
            <a asp-controller="Contact" asp-action="Index" class="btn btn-primary navbar-cta">تماس با ما</a>
        </div>

        <button class="navbar-toggle" id="navbar-toggle" aria-label="باز کردن منو">
            <span></span>
            <span></span>
            <span></span>
        </button>

    </div>
</nav>

<script>

    /* Navbar Menu Options */

    const navbarToggle = document.getElementById("navbar-toggle");
    const navbarMenu = document.getElementById("navbar-menu");


    navbarToggle.addEventListener("click", () => {

        navbarMenu.classList.toggle("active");

    });




    /*  Scrol Options */

    const navbar = document.querySelector(".navbar");

    let lastScroll = 0;


    window.addEventListener("scroll", () => {


        const currentScroll =
            window.pageYOffset;



        // اگر بالای صفحه هستیم

        if(currentScroll <= 10){

            navbar.classList.remove("hide-navbar");

            navbar.classList.remove("scrolled");

            return;

        }



        // اضافه کردن سایه

        navbar.classList.add("scrolled");



        // اسکرول به پایین

        if(currentScroll > lastScroll){


            navbar.classList.add("hide-navbar");


        }
        else {


            // اسکرول به بالا

            navbar.classList.remove("hide-navbar");


        }



        lastScroll = currentScroll;


    });
</script>