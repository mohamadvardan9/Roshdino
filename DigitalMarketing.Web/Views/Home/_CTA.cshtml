<section class="cta-section">

    <div class="cta-orb cta-orb--one"></div>
    <div class="cta-orb cta-orb--two"></div>


    <div class="container">


        <div class="cta-content">


            <span class="cta-badge">

                <i class="bi bi-rocket-takeoff"></i>

                شروع یک همکاری موفق

            </span>



            <h2 class="cta-title">

                آماده‌اید کسب‌وکارتون رو
                <span>متحول کنید؟</span>

            </h2>



            <p class="cta-desc">

                همین امروز با ما تماس بگیرید و
                مسیر رشد برند خودتون در فضای دیجیتال
                رو شروع کنید.

            </p>



            <div class="cta-actions">


                <a asp-controller="Contact"
                   asp-action="Index"
                   class="cta-primary">

                    درخواست مشاوره رایگان

                    <i class="bi bi-arrow-left"></i>

                </a>



                <a asp-controller="Product"
                   asp-action="Index"
                   class="cta-secondary">

                    مشاهده محصولات

                    <i class="bi bi-grid"></i>

                </a>


            </div>



        </div>


    </div>


</section>