@using DigitalMarketing.Web.Models
@model ErrorViewModel
@{
    ViewData["Title"] = "خطا";
}

<section class="section text-center">
    <div class="container">
        <h1>مشکلی پیش آمد</h1>
        <p class="text-muted mt-4">متأسفانه در پردازش درخواست شما خطایی رخ داد. لطفاً دوباره تلاش کنید.</p>

        @if (Model.ShowRequestId)
        {
            <p class="text-muted small mt-4">کد پیگیری: <code>@Model.RequestId</code></p>
        }

        <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-4">بازگشت به خانه</a>
    </div>
</section>