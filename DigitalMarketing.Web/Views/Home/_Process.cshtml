<section class="process-section section">

    <div class="process-bg-orb process-bg-orb--one"></div>
    <div class="process-bg-orb process-bg-orb--two"></div>

    <div class="container">

        <!-- Header -->

        <div class="section-header process-header">

            <span class="process-eyebrow">
                <i class="bi bi-diagram-3"></i>
                مسیر همکاری
            </span>

            <h2>
                از ایده تا
                <span>رشد واقعی</span>
            </h2>

            <p>
                یک فرآیند شفاف و هدفمند برای تبدیل ایده‌های شما
                به نتایج واقعی و قابل اندازه‌گیری
            </p>

        </div>


        <!-- Process -->

        <div class="process-grid">


            <!-- 01 -->

            <div class="process-item fade-right">

                <div class="process-number">
                    <span>01</span>
                </div>

                <div class="process-content">

                    <span class="process-step">
                        Discovery
                    </span>

                    <h3>
                        شناخت و کشف
                    </h3>

                    <p>
                        ابتدا کسب‌وکار، اهداف، مخاطبان و چالش‌های
                        شما را بررسی می‌کنیم تا دقیقاً بدانیم
                        چه چیزی باید ساخته یا بهبود داده شود.
                    </p>

                </div>

            </div>


            <!-- 02 -->

            <div class="process-item fade-right">

                <div class="process-number">
                    <span>02</span>
                </div>

                <div class="process-content">

                    <span class="process-step">
                        Strategy
                    </span>

                    <h3>
                        تدوین استراتژی
                    </h3>

                    <p>
                        بر اساس اطلاعات به‌دست‌آمده، یک مسیر مشخص
                        برای رسیدن به اهداف شما طراحی می‌کنیم؛
                        از انتخاب کانال‌ها تا برنامه اجرایی.
                    </p>

                </div>

            </div>


            <!-- 03 -->

            <div class="process-item fade-right">

                <div class="process-number">
                    <span>03</span>
                </div>

                <div class="process-content">

                    <span class="process-step">
                        Execution
                    </span>

                    <h3>
                        طراحی و اجرا
                    </h3>

                    <p>
                        استراتژی را به عمل تبدیل می‌کنیم؛
                        طراحی سایت، تولید محتوا، برندسازی
                        و اجرای کمپین‌های هدفمند.
                    </p>

                </div>

            </div>


            <!-- 04 -->

            <div class="process-item fade-right">

                <div class="process-number">
                    <span>04</span>
                </div>

                <div class="process-content">

                    <span class="process-step">
                        Optimization
                    </span>

                    <h3>
                        تحلیل و بهبود
                    </h3>

                    <p>
                        نتایج را با داده‌های واقعی بررسی می‌کنیم،
                        نقاط ضعف را پیدا کرده و فعالیت‌ها را
                        به‌صورت مستمر بهینه می‌کنیم.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>