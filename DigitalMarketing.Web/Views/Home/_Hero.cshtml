<section class="hero">

    <div class="hero-bg-glow hero-bg-glow--one"></div>
    <div class="hero-bg-glow hero-bg-glow--two"></div>


    <div class="container hero-inner">


        <!-- =========================
             Hero Content
        ========================== -->

        <div class="hero-text fade-right">


            <div class="hero-badge">

                <span class="hero-badge__dot"></span>

                <span>
                    رشد هوشمند با دیجیتال مارکتینگ
                </span>

            </div>



            <h1 class="hero-title">

                کسب‌وکار خود را

                <br />

                <span class="hero-title__gradient">
                    هوشمندانه رشد دهید
                </span>

            </h1>



            <p class="hero-desc">

                ما به برندها کمک می‌کنیم با استراتژی‌های
                دیجیتال مارکتینگ، مشتری بیشتری جذب کنند
                و سریع‌تر رشد کنند.

            </p>



            <div class="hero-actions">


                <a asp-controller="Contact"
                   asp-action="Index"
                   class="hero-btn hero-btn--primary">

                    <span>
                        شروع همکاری
                    </span>

                    <i class="bi bi-arrow-left"></i>

                </a>



                <a asp-controller="Product"
                   asp-action="Index"
                   class="hero-btn hero-btn--secondary">

                    <i class="bi bi-grid"></i>

                    <span>
                        نمونه کارها
                    </span>

                </a>


            </div>



            <div class="hero-trust">

                <div class="hero-trust__avatars">

                    <span>
                        <i class="bi bi-lightning-charge-fill"></i>
                    </span>

                    <span>
                        <i class="bi bi-bullseye"></i>
                    </span>

                    <span>
                        <i class="bi bi-graph-up-arrow"></i>
                    </span>

                </div>


                <div class="hero-trust__text">

                    <strong>
                        همراه برندهای در حال رشد
                    </strong>

                    <small>
                        آماده‌ایم رشد شما را شروع کنیم
                    </small>

                </div>

            </div>


        </div>



        <!-- =========================
             Hero Visual
        ========================== -->

        <div class="hero-image fade-left">


            <div class="hero-image-orbit hero-image-orbit--one"></div>

            <div class="hero-image-orbit hero-image-orbit--two"></div>



            <div class="hero-image-circle">

                <div class="hero-image-glow"></div>

                <img src="~/images/Roshdino.Logo.png"
                     alt="Roshdino Digital Marketing" />

            </div>



            <!-- Floating Cards -->


            <div class="hero-floating-card hero-floating-card--top">

                <i class="bi bi-graph-up-arrow"></i>

                <div>

                    <strong>
                        +85%
                    </strong>

                    <span>
                        رشد کسب‌وکار
                    </span>

                </div>

            </div>



            <div class="hero-floating-card hero-floating-card--bottom">

                <i class="bi bi-people-fill"></i>

                <div>

                    <strong>
                        +2.5K
                    </strong>

                    <span>
                        مشتری جدید
                    </span>

                </div>

            </div>


        </div>


    </div>

</section>